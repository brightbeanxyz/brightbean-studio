# Copy to .env on the VPS. Never commit the real file.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_KEY_SALT=replace-with-a-long-random-salt
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
DATABASE_URL=postgres://postgres:replace-db-password@postgres:5432/brightbean
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=brightbean
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-db-password
APP_DOMAIN=app.example.com
